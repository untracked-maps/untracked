{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm preview --port 4174 --strictPort",
      "startServerReadyPattern": "Local"
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://[^/]+/(?:fr)?$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.6
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 7000
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 552000
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 1391000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/(?!(?:fr)?$)",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 100
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 67000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

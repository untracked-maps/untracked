{
  "ci": {
    "collect": {
      "staticDistDir": "./build",
      "url": ["/", "/fr.html", "/privacy.html", "/fr/privacy.html"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://[^/]+/(?:fr[.]html)?$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.8
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 800
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 350000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/(?!(?:fr[.]html)?$)",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 100
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 120000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

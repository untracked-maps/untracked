{
  "name": "untracked",
  "version": "1.3.0",
  "private": true,
  "description": "Maps based on OpenStreetMap that do not track you.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/untracked-maps/untracked.git"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#configuration/*": "./src/configuration/*.ts",
    "#dependency-cruiser/*": "./.dependency-cruiser/*.ts",
    "#features/*": "./src/features/*.ts",
    "#features/*.svelte": "./src/features/*.svelte",
    "#i18n/*": "./.paraglide/*.js",
    "#libraries/*": "./src/libraries/*.ts",
    "#libraries/*.css": "./src/libraries/*.css",
    "#libraries/*.svelte": "./src/libraries/*.svelte"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev": "vite dev",
    "docs:build": "tsx src/libraries/architecture-docs/cli.ts build/docs && depcruise src --include-only '^src' --output-type archi | dot -T svg -o build/docs/dependencies.svg && NODE_OPTIONS='--import tsx' cucumber-js --format html:build/docs/features.html",
    "lint": "biome ci --error-on-warnings",
    "lint:architecture": "depcruise src vite.config.ts playwright.config.ts && folderslint $(git ls-files --cached --others --exclude-standard | sed \"s|^|$PWD/|\")",
    "lint:commit": "commitlint --from origin/main",
    "lint:duplication": "jscpd",
    "lint:fix": "biome check --write",
    "lint:generated": "! git ls-files --others --ignored --exclude-standard -- src | grep .",
    "lint:html": "html-validate \"build/**/*.html\"",
    "lint:spelling": "cspell --no-progress",
    "lint:unused": "knip && knip --production",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./.paraglide --strategy url baseLocale --emit-ts-declarations --silent && svelte-kit sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:cucumber": "NODE_OPTIONS='--import tsx' cucumber-js --format usage-json:.cucumber/usage.json && tsx src/libraries/cucumber-usage/cli.ts .cucumber/usage.json",
    "test:e2e": "playwright test",
    "test:lighthouse": "pnpm test:lighthouse:en && pnpm test:lighthouse:fr",
    "test:lighthouse:en": "lhci autorun --collect.url=http://localhost:4174/ --collect.url=http://localhost:4174/privacy --collect.settings.chromeFlags='--headless=new --accept-lang=en'",
    "test:lighthouse:fr": "lhci autorun --collect.url=http://localhost:4174/fr --collect.url=http://localhost:4174/fr/privacy --collect.settings.chromeFlags='--headless=new --accept-lang=fr-FR,fr'",
    "test:lighthouse:quick": "pnpm test:lighthouse:en --collect.numberOfRuns=1 && pnpm test:lighthouse:fr --collect.numberOfRuns=1",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:watch": "vitest"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "rxjs": "7.8.2",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@cspell/dict-fr-fr": "2.3.2",
    "@cucumber/cucumber": "13.3.0",
    "@faker-js/faker": "10.6.0",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.6.0",
    "@j178/prek": "0.5.10",
    "@lhci/cli": "0.16.0",
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "10.4.0",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "folderslint": "1.2.0",
    "fontnik": "0.7.7",
    "html-validate": "11.18.0",
    "inter-ui": "4.1.1",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "playwright": "1.64.1",
    "semantic-release": "25.0.9",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0",
    "woff2-encoder": "2.0.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  }
}

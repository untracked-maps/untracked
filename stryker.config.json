{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "mutate": [
    "src/features/**/*.{ts,svelte}",
    "src/libraries/**/*.{ts,svelte}",
    "!**/*.spec.ts",
    "!**/*.steps.ts",
    "!**/index.ts",
    "!src/features/map/abilities/show-map/implementation/openfreemap/style/{boundaries,buildings,colours,fonts,house-numbers,land,pedestrian,places,rail,road-names,roads,sprite,sprite-icons,stations,tiles,water}.ts",
    "!src/libraries/*/cli.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json"
}
